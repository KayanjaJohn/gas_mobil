# ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# GasMobil Mobile App Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git
# ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

# ─── API CONFIGURATION ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# 🔴 CRITICAL: Use your machine's local IP for development
# Run: ipconfig getifaddr en0 (Mac) or ipconfig (Windows)
# Replace 192.168.1.100 with your actual machine IP
EXPO_PUBLIC_API_URL=http://organic-engine-wp496r7gwqq39pw:3200/api

# Alternative URLs (fallbacks if above fails)
# EXPO_PUBLIC_API_URL_ALT1=http://10.0.2.2:3200/api
# EXPO_PUBLIC_API_URL_ALT2=http://127.0.0.1:3200/api

# ─── ENVIRONMENT ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── GOOGLE MAPS (for location features) ──────────────────────────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── STRIPE PUBLIC KEY (for payments) ──────────────────────────────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public_key_here

# ─── APP VERSION ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=1

# ─── FEATURE FLAGS ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
