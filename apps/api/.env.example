# ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# GasMobil API Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git
# ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

# ─── APPLICATION ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── DATABASE ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=gas_mobil
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── JWT SECRETS (Generate strong random strings - min 32 characters) ─────────────────────────────────────────────────────────────────────
# ── Security (GENERATE STRONG SECRETS - min 32 chars) ─────────
# Run: node scripts/generate-secrets.js
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_SECRET=
REFRESH_EXPIRES_IN=7d

# ─── CORS ORIGINS ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
AGENT_URL=http://localhost:3001
DRIVER_APP_URL=http://localhost:8081

# ─── STRIPE (Optional - for payments) ──────────────────────────────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ─── MTN MOMO (Mobile Money) ───────────────────────────────────────────────────────────────────────────────────────────────────────────────
MTN_MOMO_API_USER=your_mtn_api_user
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox

# ─── AIRTEL MONEY ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
AIRTEL_MONEY_CLIENT_ID=your_airtel_client_id
AIRTEL_MONEY_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa

# ─── EMAIL (SMTP for password reset, notifications) ───────────────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_oauth_token
SMTP_FROM=noreply@gasmobil.com

# ─── LOGGING ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ─── REDIS (Optional - for caching & real-time) ───────────────────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
