# ─── CORS ORIGINS ─────────────────────────────────────────────────────────────
CLIENT_URL=https://gasmobil.com
ADMIN_URL=https://gasmobil.com
AGENT_URL=https://gasmobil.com
DRIVER_APP_URL=https://gasmobil.com

# ─── JWT & AUTH ─────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRE=15m
REFRESH_SECRET=your_different_refresh_secret_key
REFRESH_EXPIRES_IN=7d

# CRITICAL: Use a completely different secret for password reset tokens
RESET_TOKEN_SECRET=your_unique_reset_token_secret_different_from_jwt

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_replace_with_actual_live_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_actual_live_webhook_secret

# ─── MTN MOMO (Mobile Money) ──────────────────────────────────────────────────
MTN_MOMO_API_USER=prod_api_user_from_mtn_portal
MTN_MOMO_API_KEY=prod_api_key_from_mtn_portal
MTN_MOMO_SUBSCRIPTION_KEY=prod_subscription_key
MTN_MOMO_BASE_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_ENVIRONMENT=production

# ─── AIRTEL MONEY ─────────────────────────────────────────────────────────────
AIRTEL_MONEY_CLIENT_ID=prod_airtel_client_id
AIRTEL_MONEY_CLIENT_SECRET=prod_airtel_client_secret
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa

# ─── EMAIL (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_prod_secret_smtp_password
SMTP_FROM=noreply@gasmobil.com

# ─── LOGGING ──────────────────────────────────────────────────────────────────
LOG_LEVEL=warn
LOG_FILE=/var/log/gasmobil/app.log

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_HOST=your-redis-host.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=super_strong_random_redis_password_string
REDIS_DB=0

# ─── DATABASE ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_NAME=gas_mobil
