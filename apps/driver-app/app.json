{
  "expo": {
    "name": "Driver GasMobil",
    "slug": "gas-mobil-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A3D2E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gasmobil.driver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A3D2E"
      },
      "package": "com.gasmobil.driver",
      "versionCode": 21,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "defaultChannel": "gasmobil-alerts-v5",
          "color": "#0A3D2E"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GasMobil uses your location to navigate deliveries and share your delivery progress."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f08f487f-63c6-4116-872a-3ce9f5917c8b"
      }
    },
    "owner": "gasmobil-uganda"
  }
}
